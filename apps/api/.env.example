# Copy this file to `.env` and replace the placeholders with real values.

# PostgreSQL connection string.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign and verify JWT access tokens.
# Use a long, random value in real environments.
JWT_SECRET="replace-with-a-long-random-secret"

# Frontend origin allowed to call the API from a browser.
WEB_ORIGIN="http://localhost:5173"

STRIPE_SECRET_KEY="sk_test_..."

STRIPE_WEBHOOK_SECRET="ffdascs"

REDIS_URL="redis://localhost:6379"
