# Copy this file to `.env` for local non-Docker development
# and replace placeholder values with appropriate development credentials.

# PostgreSQL connection string.
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign and verify JWT access tokens.
# Use a long, random value outside disposable local development.
JWT_SECRET="replace-with-a-long-random-secret"

# Port used by the NestJS API.
PORT=3000

# Frontend origin allowed to call the API from a browser.
WEB_ORIGIN="http://localhost:5173"

# Stripe test-mode credentials.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Redis connection used by the real-time infrastructure.
REDIS_URL="redis://localhost:6379"

# Kafka configuration.
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="seatlock-api"
KAFKA_DOMAIN_EVENTS_TOPIC="seatlock.domain-events"