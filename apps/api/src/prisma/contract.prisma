// SeatLock database contract
//
// Physical venue structure:
// Venue -> Screen -> Seat

enum SeatType {
  STANDARD
  PREMIUM
  ACCESSIBLE
}

enum ShowtimeSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum SeatHoldStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}


enum PaymentStatus {
  PENDING
  SUCCEEDED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
  FAILED
  CANCELLED
}

model User {
  id           Int                        @id @default(autoincrement())
  email        String                     @unique
  passwordHash String
  holds        SeatHold[]
  bookings     Booking[]
  payments     Payment[]
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model Venue {
  id        Int                        @id @default(autoincrement())
  name      String
  city      String
  address   String?
  screens   Screen[]
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Screen {
  id        Int                        @id @default(autoincrement())
  name      String
  venue     Venue                      @relation(fields: [venueId], references: [id])
  venueId   Int
  seats     Seat[]
  showtimes Showtime[]
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Seat {
  id            Int                        @id @default(autoincrement())
  row           String
  number        Int
  type          SeatType                   @default(STANDARD)
  screen        Screen                     @relation(fields: [screenId], references: [id])
  screenId      Int
  showtimeSeats ShowtimeSeat[]
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([screenId, row, number])
}

model Showtime {
  id            Int                        @id @default(autoincrement())
  title         String
  startsAt      TimestamptzString
  screen        Screen                     @relation(fields: [screenId], references: [id])
  screenId      Int
  bookings      Booking[]
  showtimeSeats ShowtimeSeat[]
  holds         SeatHold[]
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()
}

model ShowtimeSeat {
  id         Int                @id @default(autoincrement())
  showtime   Showtime           @relation(fields: [showtimeId], references: [id])
  showtimeId Int
  seat       Seat               @relation(fields: [seatId], references: [id])
  seatId     Int
  status     ShowtimeSeatStatus @default(AVAILABLE)
  price      Int
  hold       SeatHold?          @relation(fields: [holdId], references: [id])
  holdId     Int?
  booking    Booking?           @relation(fields: [bookingId], references: [id])
  bookingId  Int?
  createdAt  TimestamptzString  @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([showtimeId, seatId])
}

model SeatHold {
  id         Int               @id @default(autoincrement())
  showtime   Showtime          @relation(fields: [showtimeId], references: [id])
  showtimeId Int
  user       User              @relation(fields: [userId], references: [id])
  userId     Int
  status     SeatHoldStatus    @default(ACTIVE)
  expiresAt  TimestamptzString
  seats      ShowtimeSeat[]
  booking    Booking?
  payment    Payment?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}

model Booking {
  id         Int               @id @default(autoincrement())
  showtime   Showtime          @relation(fields: [showtimeId], references: [id])
  showtimeId Int
  hold       SeatHold          @relation(fields: [holdId], references: [id])
  holdId     Int               @unique
  user       User              @relation(fields: [userId], references: [id])
  userId     Int
  seats      ShowtimeSeat[]
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()
}


model Payment {
  id                Int                @id @default(autoincrement())
  user              User               @relation(fields: [userId], references: [id])
  userId            Int
  hold              SeatHold           @relation(fields: [holdId], references: [id])
  holdId            Int                @unique
  status            PaymentStatus      @default(PENDING)
  provider           String
  providerPaymentId String             @unique
  providerRefundId  String?            @unique
  amount             Int
  currency           String
  succeededAt       TimestamptzString?
  refundRequestedAt TimestamptzString?
  refundedAt        TimestamptzString?
  refundFailedAt     TimestamptzString?
  refundFailureReason String?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
}