{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolvePackageJsonExports": true,
    "declaration": false,
    "incremental": false,
    "types": ["node", "jest"],
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
